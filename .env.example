# Copy to .env and replace the password before starting.
APP_PASSWORD=replace-with-your-own-password
VIDEO_PROVIDER=mock
PORT=8080
HOST=127.0.0.1
DATA_DIR=./data

# Enable only when serving the app through HTTPS.
COOKIE_SECURE=false

# Required when VIDEO_PROVIDER=seedance. Enable Seedance 2.0 mini in your Ark account.
# First-frame output follows the uploaded image (adaptive), with silent MP4 output.
ARK_API_KEY=
ARK_MODEL_ID=doubao-seedance-2-0-mini-260615
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Keep disabled for normal testing. Enable temporarily only with explicit approval.
ALLOW_REAL_MODEL_TESTS=0
