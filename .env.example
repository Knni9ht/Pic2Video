# Copy to .env and replace the password before starting.
APP_PASSWORD=replace-with-your-own-password
VIDEO_PROVIDER=mock
PORT=8080
HOST=127.0.0.1
DATA_DIR=./data

# Enable only when serving the app through HTTPS.
COOKIE_SECURE=false

# Required when VIDEO_PROVIDER=seedance. Use a model enabled in your account.
ARK_API_KEY=
ARK_MODEL_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
